# Joy Health — environment variables
#
# Copy to .env and fill in. Never commit .env; it is gitignored.
# Only variables actually read by the current implementation are listed.
# The rest are here as named placeholders for the integrations the
# Codex Engineering Kickoff specifies, and should be added as each
# adapter is built.

# --- Supabase (in use) ---
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# --- Application (Sprint 0) ---
# DATABASE_URL=
# AUTH_SECRET=
# APP_URL=

# --- AI provider: OpenAI, behind AI_PHONE_INTAKE_ENABLED / AI_ASSESSMENT_ENABLED ---
# OPENAI_API_KEY=

# --- Messaging: Spruce, behind SPRUCE_ENABLED ---
# SPRUCE_API_KEY=
# SPRUCE_BASE_URL=
# SPRUCE_WEBHOOK_SECRET=

# --- Recruiting: GoHighLevel, behind GHL_ENABLED ---
# GHL_API_KEY=
# GHL_LOCATION_ID=
# GHL_WEBHOOK_SECRET=

# --- Payroll: Gusto, behind GUSTO_ENABLED ---
# GUSTO_CLIENT_ID=
# GUSTO_CLIENT_SECRET=
# GUSTO_REDIRECT_URI=

# --- Private document storage (Sprint 0) ---
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_REGION=
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
